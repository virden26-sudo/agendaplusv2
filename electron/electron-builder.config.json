{
  "appId": "com.example.agendaplus",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.education",
    "target": "dmg"
  },
  "asar": true,
  "extraResources": [
    {
      "from": "backend",
      "to": "backend",
      "filter": [
        "**/*"
      ]
    }
  ],
  "linux": {
    "target": "AppImage",
    "category": "Education"
  }
}
