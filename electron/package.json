{
  "name": "agenda-plus",
  "productName": "Agenda+",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/virden26-sudo/agendaplusv2.git"
  },
  "description": "Agenda+ Electron application for managing academic tasks.",
  "author": {
    "name": "Casper",
    "email": "geocaspvirghost@gmail.com"
  },
  "license": "MIT",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:smoke": "node tests/smoke.cjs"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "engines": {
    "node": ">=22 <25"
  }
}
